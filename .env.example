# Copy this file to .env and adjust values for this machine.

# Port the local web UI listens on.
PORT=4173

# Interface the server binds to. Keep at 127.0.0.1 so only this machine can
# reach it — only change this deliberately if you actually want LAN access.
HOST=127.0.0.1

# Root folder that contains the per-entity "P0000...P_00" directories.
EBM_DATA_ROOT=C:\Users\..

# Sub-path (relative to <EBM_DATA_ROOT>\<entity>) that archived invoices are searched in.
SOURCE_SUBPATH=Data\processed\processedArchive

# Sub-path (relative to <EBM_DATA_ROOT>\<entity>) that files are moved into for transmission.
DEST_SUBPATH=Data\resend\trnsSales

# How many sub-folder levels deep to search under SOURCE_SUBPATH.
SEARCH_MAX_DEPTH=6
